# Copy to .env and fill in before deployment:
#   cp .env.example .env && chmod 600 .env
#
# Generate secrets:
#   ./scripts/generate-secrets.sh

# --- Profile (pilot = single host; production = scaled stack) ---
DEPLOY_PROFILE=pilot

# --- Required in production (gateway refuses to start without SESSION_SECRET) ---
SESSION_SECRET=
ADMIN_SECRET=

# Dev only — never set on a public server
ALLOW_INSECURE_DEFAULTS=0

# --- Public URL (used in Continue config and cookies behind TLS) ---
PUBLIC_BASE_URL=https://lab.example.edu
SESSION_COOKIE_SECURE=1

# --- Database ---
ORCHESTRATOR_DB=/var/lib/eps/orchestrator.db

# --- Inference (LocalAI OpenAI-compatible API — never expose this port publicly) ---
INFERENCE_URL=http://127.0.0.1:8080
# Server-side key matching LocalAI LOCALAI_API_KEY (students never see this).
INFERENCE_API_KEY=
DEFAULT_CHAT_MODEL=llama-3.2-3b-instruct:q4_k_m

# --- Guardian LLM (>=1B model in LocalAI; runs after regex/AST scanners) ---
GUARDIAN_ENABLED=1
GUARDIAN_MODEL=llama-3.2-1b-instruct:q4_k_m
GUARDIAN_TIMEOUT=20
GUARDIAN_MAX_CHARS=6000
# Allow requests if guardian is down (regex/AST still apply). Set 0 to block instead.
GUARDIAN_FAIL_OPEN=1
# Legacy alias — INFERENCE_URL takes precedence when both are set.
OLLAMA_URL=http://127.0.0.1:8080

# --- Gateway (student-facing) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- Admin panel (localhost-only by design) ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8888

# --- Docker workspaces (eps-workspace image includes Continue.dev) ---
DOCKER_NETWORK=gateway_net
WORKSPACE_IMAGE=eps-workspace:latest
# Gateway URL as seen from inside workspace containers (Compose: http://gateway:8000).
WORKSPACE_GATEWAY_URL=http://gateway:8000
WORKSPACE_PORT=8080

# --- Rate limits ---
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_LOGIN_WINDOW=10
RATE_LIMIT_REGISTER_PER_HOUR=5
MAX_REQUEST_BODY_BYTES=1048576

# --- Registration ---
DISABLE_API_REGISTER=1
